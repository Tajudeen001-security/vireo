{
  "name": "vireo",
  "version": "0.1.0",
  "private": true,
  "description": "Vireo — AI-powered full-stack website & app builder. Plan first, preview before write, ship with ownership.",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @vireo/db generate",
    "db:migrate": "pnpm --filter @vireo/db migrate",
    "db:studio": "pnpm --filter @vireo/db studio"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20"
  }
}
