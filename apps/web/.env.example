# ─────────────────────────────────────────────
# FREE LLM providers (pick at least one — no credit card needed)
# Priority: GROQ → GEMINI → OPENROUTER → offline stub
# ─────────────────────────────────────────────

# Groq — fastest free tier
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional model override (default: qwen/qwen3.8-27b)
# GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini — best free quality
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# or GOOGLE_API_KEY=
# Optional: GEMINI_MODEL=gemini-2.5-flash

# OpenRouter — many free models (:free)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# ─────────────────────────────────────────────
# Optional later
# ─────────────────────────────────────────────
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
E2B_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
