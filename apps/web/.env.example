# ─────────────────────────────────────────────
# FREE LLM providers — multi-agent
# Planner prefers Gemini; falls back to Groq if Gemini is busy
# ─────────────────────────────────────────────

# Google Gemini (recommended for planning quality)
# Get key: https://aistudio.google.com/apikey
# Verified working models: gemma-4-26b-a4b-it, gemma-4-31b-it
GEMINI_API_KEY=
# Optional model (default tries gemma-4 then flash models)
# GEMINI_MODEL=gemma-4-26b-a4b-it

# Groq (fast fallback + future Coder agent)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter (optional free models)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# ─────────────────────────────────────────────
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
E2B_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
