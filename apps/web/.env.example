# ═══════════════════════════════════════════════════════════
# Vireo — environment variables
# Local:  copy to .env.local  →  cp .env.example .env.local
# Vercel: Project Settings → Environment Variables (same names)
# ═══════════════════════════════════════════════════════════

# ── LLM providers (pick at least one free key) ─────────────
# Priority: Gemini → Groq → OpenRouter → offline stub

# OpenRouter (you have this) — free models end with :free
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Recommended free model:
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# Alternatives: google/gemma-3-27b-it:free  meta-llama/llama-3.3-70b-instruct:free

# Google Gemini (optional, quality)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemma-4-26b-a4b-it

# Groq (optional, speed)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b

# ── App URL (set on Vercel to your domain) ─────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional later
# DATABASE_URL=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
